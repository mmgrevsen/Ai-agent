# Kopiér denne fil til .env og indsæt din egen nøgle.
# .env bliver ALDRIG lagt op på GitHub (den står i .gitignore).

# Hent en nøgle på https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Hvilken virksomhed (filnavn i mappen kunder/ uden .json)
KUNDE=glanspunkt

# Valgfrit: anden model eller indsats. Standard er claude-opus-5-5 med effort "low".
# MODEL=claude-haiku-5-5
# EFFORT=low

# PORT=3000

# ---------- Telefon via Vapi (se VAPI.md) ----------
# Din PRIVATE nøgle fra dashboard.vapi.ai → API Keys
# VAPI_API_KEY=
# Lang tilfældig tekst, som kun din server og Vapi kender. Opsætningsscriptet kan lave en.
# VAPI_HEMMELIGHED=
# Adressen fra din tunnel, fx https://noget-tilfaeldigt.trycloudflare.com
# OFFENTLIG_URL=
# Udfyldes efter første "npm run vapi:opsaet"
# VAPI_ASSISTENT_ID=
# Dansk stemme fra Azure: da-DK-ChristelNeural (kvinde) eller da-DK-JeppeNeural (mand)
# VAPI_STEMME=da-DK-ChristelNeural
