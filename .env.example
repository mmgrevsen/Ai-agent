# Kopiér denne fil til .env og indsæt din egen nøgle.
# .env bliver ALDRIG lagt op på GitHub (den står i .gitignore).

# Hent en nøgle på https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Hvilken virksomhed (filnavn i mappen kunder/ uden .json)
KUNDE=glanspunkt

# Valgfrit: anden model eller indsats. Standard er claude-opus-5-5 med effort "low".
# MODEL=claude-haiku-5-5
# EFFORT=low

# PORT=3000
